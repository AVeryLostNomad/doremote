# Copy to .dev.vars for `wrangler dev`. Generate SESSION_SECRET with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
# GitHub OAuth app (callback URL: http://localhost:8787/auth/callback for dev)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
